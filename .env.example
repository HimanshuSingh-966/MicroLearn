# MicroLearn canonical environment template
# Single checked-in template. Copy this once to the project-root .env and keep
# deployment values here. Never commit a populated .env or expose server secrets.

# OCI backend (server-side only)
PORT=3000
NODE_ENV=production
MICROLEARN_DATA_DIR=/var/lib/microlearn/data
MAX_IMAGE_BYTES=12582912
MAX_ACTIVE_INFERENCE_JOBS=2
INFERENCE_URL=http://127.0.0.1:8000
INFERENCE_TIMEOUT_MS=120000
MICROLEARN_DOMAIN=yourname.duckdns.org
MICROLEARN_PUBLIC_URL=https://yourname.duckdns.org
# Exact Google AI Studio published origin: scheme + host, no path.
ALLOWED_ORIGINS=https://your-published-app.ai.studio
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
STUN_URL=stun:stun.l.google.com:19302
TURN_URLS=
TURN_SHARED_SECRET=
HF_MODEL_REPO_ID=your-account/microlearn-onion-unet
HF_MODEL_REVISION=main
HF_TOKEN=
MODEL_PATH=/var/lib/microlearn/model/best.pt
MODEL_METADATA_PATH=/var/lib/microlearn/model/metadata.json
HF_HUB_CACHE=/var/lib/microlearn/model/hf-cache

# Google AI Studio frontend build-time settings (public; never put secrets here)
VITE_OCI_API_BASE_URL=https://yourname.duckdns.org/api
VITE_WEBRTC_SIGNALING_URL=wss://yourname.duckdns.org/ws/signaling
VITE_STUN_URL=stun:stun.l.google.com:19302

# Raspberry Pi camera agent (device-side; no cloud secrets)
# MICROLEARN_API_BASE_URL is the OCI origin without /api or another path.
MICROLEARN_API_BASE_URL=https://yourname.duckdns.org
MICROLEARN_PEER_ID=rpi4-csi-camera
CAMERA_PREVIEW_WIDTH=640
CAMERA_PREVIEW_HEIGHT=480
CAMERA_PREVIEW_FPS=15
MAX_STILL_BYTES=12582912
LOG_LEVEL=INFO
