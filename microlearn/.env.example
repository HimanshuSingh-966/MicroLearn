# -----------------------------------------------------------------------------
# Server-side secrets ONLY (NEVER expose these in frontend code or VITE_* vars)
# -----------------------------------------------------------------------------
# GEMINI_API_KEY, HF_TOKEN, and TURN_SHARED_SECRET belong strictly on the OCI backend.
GEMINI_API_KEY="MY_GEMINI_API_KEY"
APP_URL="MY_APP_URL"

# -----------------------------------------------------------------------------
# Frontend build-time configuration (Vite / Google AI Studio deployment)
# -----------------------------------------------------------------------------
# OCI Backend API Base URL via DuckDNS HTTPS domain (used for /inference/jobs, /chat, /webrtc/ice-servers, and relative mask paths)
VITE_OCI_API_BASE_URL="https://<actual-duckdns-host>/api"

# OCI WebRTC Signaling WebSocket URL via DuckDNS WSS domain
VITE_WEBRTC_SIGNALING_URL="wss://<actual-duckdns-host>/ws/signaling"

# Public STUN server URL for WebRTC NAT traversal (short-lived TURN credentials come from OCI GET /webrtc/ice-servers)
VITE_STUN_URL="stun:stun.l.google.com:19302"
